{
  "name": "ornito",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "main": "./dist/ornito.js",
  "module": "./dist/ornito.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/tokens.css",
    "src/theme.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ornito.js"
    },
    "./style.css": "./dist/ornito.css",
    "./tokens.css": "./src/tokens.css",
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:types": "DTS=true vite build --config vite.lib.config.ts",
    "preview": "vite preview",
    "docs:dev": "vuepress dev docs",
    "docs:build": "vuepress build docs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "simple-git-hooks": {
    "pre-push": "pnpm lint"
  },
  "peerDependencies": {
    "@vueuse/core": "^12.8.2 || ^13.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/language-core": "^3.3.9",
    "@vue/tsconfig": "^0.9.1",
    "@vuepress/bundler-vite": "2.0.0-rc.30",
    "@vuepress/theme-default": "2.0.0-rc.132",
    "oxlint": "^1.77.0",
    "sass-embedded": "^1.100.0",
    "typescript": "~6.0.2",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.2.0",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.8",
    "vuepress": "2.0.0-rc.30",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-vue-components": "^28.8.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@vuepic/vue-datepicker": "^12.1.0",
    "date-fns": "^4.1.0",
    "maska": "^3.2.0",
    "v-money3": "^3.24.1",
    "vee-validate": "^4.15.0",
    "yup": "^1.7.0",
    "@tabler/icons-vue": "^3.41.1"
  }
}
